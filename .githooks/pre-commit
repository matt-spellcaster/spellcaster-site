#!/bin/sh
# Block commits that include key material, Terraform state or real settings.
# This repository is public: backend.hcl and *.tfvars name the AWS account.
# Enable with: git config core.hooksPath .githooks
fail=0
for f in $(git diff --cached --name-only --diff-filter=ACMR); do
  case "$f" in
    .env | .env.* | *.pem | *.key | *.p8 | *.p12 | *.tfstate | *.tfstate.* | backend.hcl | */backend.hcl | *.tfvars)
      echo "pre-commit: refusing to commit $f" >&2; fail=1 ;;
  esac
done
if git diff --cached -U0 | grep -qE '^\+.*-----BEGIN ([A-Z]+ )?PRIVATE KEY-----'; then
  echo "pre-commit: staged changes contain a private key" >&2; fail=1
fi
# AWS account IDs stay out of this public repository (CI reads them from secrets).
if git diff --cached -U0 | grep -E '^\+' | grep -qE '(^|[^0-9])[0-9]{12}([^0-9]|$)' ; then
  git diff --cached -U0 | grep -E '^\+' | grep -nE '(^|[^0-9])[0-9]{12}([^0-9]|$)' >&2
  echo "pre-commit: a staged line contains a 12-digit number (an AWS account ID?)." >&2
  echo "            If it's safe, commit with --no-verify." >&2
  fail=1
fi
exit $fail
