{
  "name": "spellcaster-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Matthew Spell's portfolio site, https://spellcaster.foo/",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "dev": "astro dev --host 0.0.0.0 --port 4321",
    "build": "astro build",
    "preview": "astro preview --host 0.0.0.0 --port 4321",
    "check": "astro check",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --project unit",
    "test:dist": "vitest run --project dist",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run check && npm test && npm run build && npm run test:dist && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.1",
    "@astrojs/react": "6.0.5",
    "@astrojs/sitemap": "3.7.4",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.10.0",
    "eslint-plugin-astro": "3.1.0",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.1"
  }
}
