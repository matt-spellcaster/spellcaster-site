---
// A Popover API sheet: opening, closing, Esc, outside clicks and focus return all work
// without JavaScript. The small script only closes the sheet after an in-page link.
import { site, type SiteLink } from '../data/site';

interface Props {
  links: SiteLink[];
}

const { links } = Astro.props;
---

<button
  type="button"
  popovertarget="site-menu"
  class="menu-button text-ink hover:bg-surface-2 -mr-2 inline-flex min-h-11 items-center rounded-lg px-3 font-sans text-sm font-medium sm:hidden"
>
  Menu
</button>

<div id="site-menu" popover class="glass glass-strong menu-sheet border-b">
  <nav aria-label="Main menu" class="max-w-page mx-auto px-5 pb-6">
    <!-- The same row as the header, so the open sheet reads as the header growing down. -->
    <div class="flex h-14 items-center justify-between">
      <a href="/" class="text-ink text-[1.25rem] font-medium">
        {site.name}
      </a>
      <button
        type="button"
        popovertarget="site-menu"
        popovertargetaction="hide"
        class="text-ink hover:bg-surface-2 -mr-2 inline-flex min-h-11 items-center rounded-lg px-3 font-sans text-sm font-medium"
      >
        Close
      </button>
    </div>
    <ul class="mt-2">
      {links.map((link) => (
        <li>
          <a
            href={link.href}
            class="text-ink hover:text-accent flex min-h-12 items-center font-sans text-lg font-medium"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</div>

<style>
  .menu-sheet {
    /* The UA centres popovers; this one hangs from the top edge instead. */
    inset: 0 0 auto 0;
    width: 100%;
    max-width: none;
    margin: 0;
    padding: 0;
    color: inherit;
  }
  .menu-sheet::backdrop {
    background: rgb(0 0 0 / 0.4);
  }
  @media (forced-colors: active) {
    .menu-sheet::backdrop {
      background: transparent;
    }
  }
  /* Without the Popover API (Safari before 17, for one) the sheet would sit open inside the
     header and the button would do nothing. There, the menu goes; the page still scrolls
     to every section. */
  @supports not selector(:popover-open) {
    .menu-sheet,
    .menu-button {
      display: none;
    }
  }
</style>

<script>
  const menu = document.getElementById('site-menu');
  menu?.addEventListener('click', (event) => {
    if (event.target instanceof Element && event.target.closest('a')) menu.hidePopover();
  });
</script>
