---
import { site } from '../data/site';
import Horizon from './Horizon.astro';
import TextLink from './TextLink.astro';

const links = [
  { label: 'GitHub', href: site.github },
  ...(site.linkedin ? [{ label: 'LinkedIn', href: site.linkedin }] : []),
  { label: 'Email', href: `mailto:${site.email}` },
];
---

<!-- The name is in the header (the page's h1), so the page opens on the pitch. -->
<section class="pt-24 sm:pt-32">
  {site.jobTitle && <p class="text-muted mb-4 font-sans text-sm">{site.jobTitle}</p>}
  <p class="text-ink max-w-[24ch] text-[1.75rem] leading-[1.35] tracking-[-0.01em] sm:text-[2.125rem]">
    {site.pitch}
  </p>
  <ul class="mt-5 flex flex-wrap gap-x-6">
    {links.map((link) => (
      <li>
        <TextLink href={link.href}>{link.label}</TextLink>
      </li>
    ))}
  </ul>
  <Horizon />
</section>
