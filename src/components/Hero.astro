---
import { site } from '../data/site';

const links = [
  { label: 'Resume (PDF)', href: site.resume, primary: true },
  { label: 'GitHub', href: site.github, primary: false },
  ...(site.linkedin ? [{ label: 'LinkedIn', href: site.linkedin, primary: false }] : []),
  { label: 'Email', href: `mailto:${site.email}`, primary: false },
];
---

<section class="relative pt-32 pb-16 sm:pt-44 sm:pb-24">
  <h1 class="text-ink text-4xl font-semibold tracking-tight sm:text-6xl">{site.name}</h1>
  {site.jobTitle && <p class="text-muted mt-3 text-lg sm:text-xl">{site.jobTitle}</p>}
  <p class="text-ink/90 mt-6 max-w-[62ch] text-lg leading-relaxed sm:text-xl sm:leading-relaxed">
    {site.pitch}
  </p>
  <ul class="mt-9 flex flex-wrap gap-3">
    {links.map((link) => (
      <li>
        <a
          href={link.href}
          class:list={[
            'inline-flex min-h-11 items-center rounded-lg px-4 text-sm font-medium transition-colors',
            link.primary
              ? 'bg-accent text-canvas hover:bg-ink'
              : 'border-line text-ink hover:bg-surface-2 border',
          ]}
        >
          {link.label}
        </a>
      </li>
    ))}
  </ul>
</section>
