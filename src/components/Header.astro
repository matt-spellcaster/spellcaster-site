---
// Fixed and frosted. No ancestor may set a transform, a filter or containment:
// any of those would break the fixed position and the glass (an E2E test checks).
import { nav, site } from '../data/site';
import MobileMenu from './MobileMenu.astro';

interface Props {
  /** On the home page the name here is the page's h1: the hero goes straight to the pitch. */
  nameIsH1?: boolean;
}

const { nameIsH1 = false } = Astro.props;
const name = 'text-ink text-[1.25rem] font-medium';
---

<header class="glass fixed inset-x-0 top-0 z-50 border-b">
  <div class="max-w-page mx-auto flex h-14 items-center justify-between px-5 sm:px-8">
    {nameIsH1 ? (
      <h1 class={name}>
        <a href="/">{site.name}</a>
      </h1>
    ) : (
      <a href="/" class={name}>
        {site.name}
      </a>
    )}
    <nav aria-label="Main" class="hidden font-sans sm:block">
      <ul class="flex items-center gap-1">
        {nav.map((link) => (
          <li>
            <a
              href={link.href}
              class="text-muted hover:text-ink inline-flex min-h-11 items-center rounded-lg px-3 text-sm"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <MobileMenu links={nav} />
  </div>
</header>
