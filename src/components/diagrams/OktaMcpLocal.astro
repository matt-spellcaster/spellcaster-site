---
// From okta-mcp-local's README, "How it works": Claude talks to run.sh over stdio, run.sh
// reads the key from 1Password and starts the pinned server, which signs a JWT for Okta.
// Drawn 240 wide, about the narrowest a card shows it (at 640px), so 11-unit text stays 11px.
---

<!-- prettier-ignore -->
<svg
  viewBox="0 0 240 160"
  role="img"
  aria-labelledby="okta-mcp-local-title okta-mcp-local-desc"
  class="h-auto w-full"
>
  <title id="okta-mcp-local-title">How okta-mcp-local works</title>
  <desc id="okta-mcp-local-desc">
    Claude talks to run.sh over stdio. run.sh reads the private key from 1Password, with your
    approval, and starts the pinned Okta MCP server, which signs in to Okta with a signed JWT. Okta
    limits it with scopes, an admin role and a network zone.
  </desc>
  <g class="fill-surface-2 stroke-line-strong" stroke-width="1">
    <rect x="1" y="20" width="70" height="32" rx="7"></rect>
    <rect x="85" y="20" width="70" height="32" rx="7"></rect>
    <rect x="169" y="20" width="70" height="32" rx="7"></rect>
    <rect x="85" y="98" width="70" height="32" rx="7"></rect>
    <rect x="169" y="98" width="70" height="32" rx="7"></rect>
  </g>
  <g class="fill-ink" font-size="11" font-weight="500" text-anchor="middle">
    <text x="36" y="40">Claude</text>
    <text x="120" y="40">run.sh</text>
    <text x="204" y="40">MCP server</text>
    <text x="120" y="118">1Password</text>
    <text x="204" y="118">Okta</text>
  </g>
  <g class="fill-muted" font-size="11" text-anchor="end">
    <text x="78" y="13" text-anchor="middle">stdio</text>
    <text x="198" y="66">pinned</text>
    <text x="198" y="84">signed JWT</text>
    <text x="114" y="74">key, only</text>
    <text x="114" y="87">with approval</text>
    <text x="202" y="145" text-anchor="middle">scopes, role,</text>
    <text x="202" y="157" text-anchor="middle">network zone</text>
  </g>
  <g class="stroke-accent" stroke-width="1.5" fill="none">
    <path d="M71 36 H81"></path>
    <path d="M155 36 H165"></path>
    <path d="M120 98 V56"></path>
    <path d="M204 52 V94"></path>
  </g>
  <g class="fill-accent">
    <polygon points="84,36 78,32.5 78,39.5"></polygon>
    <polygon points="168,36 162,32.5 162,39.5"></polygon>
    <polygon points="120,53 116.5,59 123.5,59"></polygon>
    <polygon points="204,97 200.5,91 207.5,91"></polygon>
  </g>
</svg>
