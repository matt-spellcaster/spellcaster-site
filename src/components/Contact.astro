---
import { site } from '../data/site';
---

<section
  id="contact"
  aria-labelledby="contact-title"
  class="mt-12 grid gap-3 pb-16 sm:grid-cols-[10rem_minmax(0,1fr)] sm:items-baseline sm:gap-6 sm:pb-24"
>
  <h2 id="contact-title" class="text-ink text-[1.375rem] font-medium">
    Contact
  </h2>
  <p>
    <a
      href={`mailto:${site.email}`}
      class="text-ink decoration-ink/40 hover:text-accent hover:decoration-accent text-[1.25rem] underline underline-offset-[6px] transition-colors"
    >
      {site.email}
    </a>
  </p>
</section>
