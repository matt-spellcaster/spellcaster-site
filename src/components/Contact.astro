---
import { site } from '../data/site';
import TextLink from './TextLink.astro';
---

<section
  id="contact"
  aria-labelledby="contact-title"
  class="mt-12 grid gap-3 pb-16 sm:grid-cols-[10rem_minmax(0,1fr)] sm:items-baseline sm:gap-6 sm:pb-24"
>
  <h2 id="contact-title" class="text-ink text-[1.375rem] font-medium">
    Contact
  </h2>
  <p>
    <TextLink href={`mailto:${site.email}`}>{site.email}</TextLink>
  </p>
</section>
