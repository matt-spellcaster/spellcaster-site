---
import { getCollection } from 'astro:content';
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Featured from '../components/Featured.astro';
import Hero from '../components/Hero.astro';
import TextLink from '../components/TextLink.astro';
import { site } from '../data/site';
import Base from '../layouts/Base.astro';

const others = (await getCollection('projects', (p) => !p.data.featured)).sort(
  (a, b) => a.data.order - b.data.order,
);

// schema.org Person. No email: that stays a mailto link on the page.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: new URL('/', Astro.site).href,
  ...(site.jobTitle ? { jobTitle: site.jobTitle } : {}),
  sameAs: [site.github, ...(site.linkedin ? [site.linkedin] : [])],
};
---

<Base
  title={site.name}
  description={site.description}
  ogImage="/og/home.jpg"
  ogImageAlt={`${site.name}: full stack IT portfolio`}
  jsonLd={person}
  nameIsH1
>
  <Hero />
  <Featured />
  <section aria-labelledby="more-title" class="mt-16 sm:mt-20">
    <h2 id="more-title" class="eyebrow">
      More projects
    </h2>
    <!-- A ledger: name, one line, and the link. The link covers the whole row, and the row
         shows it on hover (the name turns accent). The one-liner sits above the link so it can
         be selected and copied. -->
    <ul class="border-line mt-2 border-b">
      {others.map((project) => (
        <li class="border-line group relative grid gap-x-6 gap-y-1 border-t py-4 sm:grid-cols-[13rem_minmax(0,1fr)_5rem] sm:items-baseline">
          <h3 class="text-ink group-hover:text-accent text-xl transition-colors">
            {project.data.title}
          </h3>
          <p class="text-ink/70 relative z-10 text-[1.0625rem] leading-[1.5]">
            {project.data.summary}
          </p>
          <TextLink
            href={project.data.repo}
            tone="accent"
            class="group-hover:decoration-accent after:absolute after:inset-0 sm:justify-self-end"
          >
            GitHub<span class="sr-only">: {project.data.title}</span>
          </TextLink>
        </li>
      ))}
    </ul>
  </section>
  <About />
  <Contact />
</Base>
