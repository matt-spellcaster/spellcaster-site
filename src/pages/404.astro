---
import LinkButton from '../components/LinkButton.astro';
import { site } from '../data/site';
import Base from '../layouts/Base.astro';
---

<Base
  title={`Page not found | ${site.name}`}
  description="There's no page at this address."
  ogImage="/og/home.png"
  ogImageAlt={`${site.name}: IAM and IT systems engineering portfolio`}
  noindex
>
  <section class="pt-32 pb-24 sm:pt-44">
    <p class="text-accent text-sm font-medium">404</p>
    <h1 class="text-ink mt-2 text-3xl font-semibold tracking-tight sm:text-5xl">Page not found</h1>
    <p class="text-muted mt-4 text-lg">There's no page at this address.</p>
    <LinkButton href="/" variant="primary" class="mt-8">
      Go to the home page
    </LinkButton>
  </section>
</Base>
