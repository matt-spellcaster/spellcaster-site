---
// Design gate only (M2). Deleted once docs/design.md records the choices.
import { Image } from 'astro:assets';
import report from '../../assets/okta/report-page-1.png';
import Featured from '../../components/Featured.astro';
import Hero from '../../components/Hero.astro';
import Base from '../../layouts/Base.astro';

export function getStaticPaths() {
  return [{ params: { font: 'inter' } }, { params: { font: 'geist' } }];
}

const font = Astro.params.font === 'geist' ? 'geist' : 'inter';
const label = font === 'geist' ? 'Geist' : 'Inter';
const accents = [
  { name: 'Blue (proposed)', hex: '#8ab4f8' },
  { name: 'Teal', hex: '#5fd0c0' },
  { name: 'Violet', hex: '#b4a4ff' },
];
---

<Base
  title={`Mockup: ${label}`}
  description="Design mockup for the M2 design gate."
  font={font}
  noindex
>
  <Hero />
  <Featured />

  <section id="glass-test" aria-labelledby="glass-test-title" class="border-line border-t py-16">
    <h2 id="glass-test-title" class="text-ink text-xl font-semibold">
      Mockup only: a white image under the header
    </h2>
    <p class="text-muted mt-2 text-sm">
      The worst case for the glass. Scroll this under the header to check that the name and the
      links stay readable.
    </p>
    <div class="mt-6 rounded-xl bg-white p-4">
      <Image
        src={report}
        widths={[480, 960, 1584]}
        sizes="(min-width: 1024px) 960px, calc(100vw - 2.5rem)"
        alt="Page 1 of the sample access review report"
        class="h-auto w-full"
      />
    </div>
  </section>

  <section id="accents" aria-labelledby="accents-title" class="border-line border-t py-16">
    <h2 id="accents-title" class="text-ink text-xl font-semibold">
      Mockup only: accent options
    </h2>
    <ul class="mt-6 grid gap-4 sm:grid-cols-3">
      {accents.map((accent) => (
        <li class="border-line bg-surface rounded-xl border p-5">
          <p class="text-sm font-medium" style={`color: ${accent.hex}`}>
            Featured project
          </p>
          <p class="text-ink mt-2 font-semibold">{accent.name}</p>
          <p class="text-muted text-sm tabular-nums">{accent.hex}</p>
          <span
            class="text-canvas mt-4 inline-flex min-h-11 items-center rounded-lg px-4 text-sm font-medium"
            style={`background-color: ${accent.hex}`}
          >
            Read the case study
          </span>
        </li>
      ))}
    </ul>
  </section>
  <!-- Room to scroll the white image under the header at every width. -->
  <div aria-hidden="true" class="h-screen"></div>
</Base>
