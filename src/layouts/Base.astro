---
import { Font } from 'astro:assets';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Sky from '../components/Sky.astro';
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** A 1200x630 PNG in public/og/ (scripts/og-images.ts makes them). */
  ogImage: string;
  ogImageAlt: string;
  type?: 'website' | 'article';
  /** Structured data for search engines (schema.org). */
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
  /** The home page: the name in the header is the h1. */
  nameIsH1?: boolean;
}

const {
  title,
  description,
  ogImage,
  ogImageAlt,
  type = 'website',
  jsonLd,
  noindex,
  nameIsH1 = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const image = new URL(ogImage, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#111010" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Both faces are on screen at once (the pitch and the nav), so both preload. -->
    <Font cssVariable="--font-newsreader" preload />
    <Font cssVariable="--font-inter" preload />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>}
  </head>
  <body class="bg-canvas text-ink min-h-dvh font-serif antialiased">
    <a
      href="#main"
      class="bg-accent text-canvas fixed top-2 left-2 z-[60] -translate-y-20 rounded-lg px-4 py-3 font-sans text-sm font-medium focus:translate-y-0"
    >
      Skip to content
    </a>
    <Header nameIsH1={nameIsH1} />
    <Sky />
    <main id="main" class="max-w-page mx-auto px-5 sm:px-8">
      <slot />
    </main>
    <Footer />
  </body>
</html>
